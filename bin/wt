#!/usr/bin/env bash
# wt — personal Momence feature-worktree helper
set -euo pipefail

WT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/create.sh
source "$WT_HOME/lib/create.sh"

usage() {
  cat <<'HELP'
wt — personal helper for Momence feature git worktrees

  wt                 Pick a worktree with fzf and print its path (zsh: cd)
  wt new <branch> [path] [--no-install] [--from <ref>]
  wt list
  wt go [query]      Pick a worktree (fzf) and print its path
  wt rm [query] [--force]
  wt open [query]
  wt prune

Hardcoded for the Momence monorepo layout (.worktrees/, env copy, yarn).
Only manages checkouts under <repo>/.worktrees/ — not Cursor agent trees.

list/go lines show: dirty *, open PR ✓#N, and last commit subject (max 100 chars).
HELP
}

require_fzf() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive pick. Install it: brew install fzf" >&2
    exit 1
  fi
}

repo_root() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || { echo "Not inside a git repository." >&2; exit 1; }
  if [[ "$(basename "$common")" == ".git" ]]; then
    dirname "$common"
  else
    git rev-parse --path-format=absolute --show-toplevel
  fi
}

looks_like_momence() {
  local root="$1"
  [[ -d "$root/backend" && -d "$root/frontend" && -d "$root/eslint-plugin" ]]
}

warn_if_not_momence() {
  local root="$1"
  if ! looks_like_momence "$root"; then
    echo "Warning: this does not look like the Momence monorepo (expected backend/, frontend/, eslint-plugin/)." >&2
  fi
}

load_pr_map() {
  local root="$1"
  WT_PR_MAP=()
  WT_GH_REPO=""
  if ! command -v gh >/dev/null 2>&1; then
    return 0
  fi

  local remote
  remote="$(git -C "$root" remote get-url origin 2>/dev/null || true)"
  WT_GH_REPO="$(printf '%s\n' "$remote" | sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##')"
  if [[ -z "$WT_GH_REPO" || "$WT_GH_REPO" != */* ]]; then
    WT_GH_REPO=""
  fi
}

# Prefer an open PR; otherwise any PR for the branch. Cache in WT_PR_MAP.
pr_for_branch() {
  local want="$1" entry head num
  for entry in "${WT_PR_MAP[@]+"${WT_PR_MAP[@]}"}"; do
    head="${entry%%$'\t'*}"
    num="${entry#*$'\t'}"
    if [[ "$head" == "$want" ]]; then
      if [[ "$num" == "-" ]]; then
        return 1
      fi
      printf '%s\n' "$num"
      return 0
    fi
  done

  if [[ -z "${WT_GH_REPO:-}" ]]; then
    return 1
  fi

  local found=""
  found="$(gh pr list -R "$WT_GH_REPO" --head "$want" --state open --limit 1 \
    --json number --jq '.[0].number // empty' 2>/dev/null || true)"
  if [[ -z "$found" ]]; then
    found="$(gh pr list -R "$WT_GH_REPO" --head "$want" --state all --limit 1 \
      --json number --jq '.[0].number // empty' 2>/dev/null || true)"
  fi

  if [[ -n "$found" ]]; then
    WT_PR_MAP+=("${want}"$'\t'"${found}")
    printf '%s\n' "$found"
    return 0
  fi

  WT_PR_MAP+=("${want}"$'\t'"-")
  return 1
}
truncate_subject() {
  local s="$1"
  local max="${2:-100}"
  if ((${#s} > max)); then
    printf '%s\n' "${s:0:$((max - 1))}…"
  else
    printf '%s\n' "$s"
  fi
}

worktree_dirty() {
  local path="$1"
  if ! git -C "$path" diff --quiet HEAD 2>/dev/null || ! git -C "$path" diff --cached --quiet 2>/dev/null; then
    return 0
  fi
  if [[ -n "$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null | head -1)" ]]; then
    return 0
  fi
  return 1
}

format_label() {
  local name="$1" path="$2" branch="$3" is_main="$4"
  local dirty="" pr="" subj=""

  if worktree_dirty "$path"; then
    dirty=" *"
  fi

  subj="$(git -C "$path" log -1 --pretty=%s 2>/dev/null || true)"
  subj="$(truncate_subject "$subj" 100)"

  if [[ "$is_main" -eq 0 && -n "$branch" ]]; then
    local num
    if num="$(pr_for_branch "$branch")"; then
      pr=" ✓#$num"
    fi
  fi

  if [[ "$is_main" -eq 1 ]]; then
    printf '%s\t%s (main)%s%s  %s' "$name" "$path" "$dirty" "$pr" "$subj"
  else
    printf '%s\t%s%s%s  %s' "$name" "$path" "$dirty" "$pr" "$subj"
  fi
}

load_feature_worktrees() {
  local root="$1"
  local include_main="${2:-0}"
  WT_PATHS=()
  WT_LABELS=()

  load_pr_map "$root"

  local path="" branch="" bare=0 detached=0
  local prefix="$root/.worktrees/"

  flush() {
    [[ -z "$path" ]] && return 0
    if [[ "$include_main" -eq 1 && "$path" == "$root" ]]; then
      WT_PATHS+=("$path")
      WT_LABELS+=("$(format_label "main" "$path" "" 1)")
      return 0
    fi
    case "$path" in
      "$prefix"*)
        local name="$branch"
        [[ -z "$name" && "$detached" -eq 1 ]] && name="(detached)"
        [[ -z "$name" ]] && name="$(basename "$path")"
        WT_PATHS+=("$path")
        WT_LABELS+=("$(format_label "$name" "$path" "$branch" 0)")
        ;;
    esac
  }

  while IFS= read -r line; do
    if [[ -z "$line" ]]; then
      flush
      path=""; branch=""; bare=0; detached=0
      continue
    fi
    case "$line" in
      worktree\ *) path="${line#worktree }" ;;
      branch\ *) branch="${line#branch refs/heads/}" ;;
      bare) bare=1 ;;
      detached) detached=1 ;;
    esac
  done < <(git worktree list --porcelain)
  flush
}

pick_worktree() {
  local root="$1"
  local query="${2:-}"
  local include_main="${3:-0}"

  load_feature_worktrees "$root" "$include_main"

  if [[ ${#WT_PATHS[@]} -eq 0 ]]; then
    echo "No feature worktrees under $root/.worktrees/" >&2
    exit 1
  fi

  local filtered_paths=() filtered_labels=()
  local i
  if [[ -n "$query" ]]; then
    for i in "${!WT_PATHS[@]}"; do
      if [[ "${WT_LABELS[$i]}" == *"$query"* || "${WT_PATHS[$i]}" == *"$query"* ]]; then
        filtered_paths+=("${WT_PATHS[$i]}")
        filtered_labels+=("${WT_LABELS[$i]}")
      fi
    done
  else
    filtered_paths=("${WT_PATHS[@]}")
    filtered_labels=("${WT_LABELS[@]}")
  fi

  if [[ ${#filtered_paths[@]} -eq 0 ]]; then
    echo "No worktree matched: $query" >&2
    exit 1
  fi

  if [[ ${#filtered_paths[@]} -eq 1 ]]; then
    printf '%s\n' "${filtered_paths[0]}"
    return 0
  fi

  require_fzf

  local choice
  choice="$(printf '%s\n' "${filtered_labels[@]}" | fzf --height=40% --reverse --prompt='worktree> ')" || exit 1
  for i in "${!filtered_labels[@]}"; do
    if [[ "${filtered_labels[$i]}" == "$choice" ]]; then
      printf '%s\n' "${filtered_paths[$i]}"
      return 0
    fi
  done
  echo "Selection did not match a known worktree." >&2
  exit 1
}

cmd_list() {
  local root
  root="$(repo_root)"
  warn_if_not_momence "$root"
  load_feature_worktrees "$root" 1
  if [[ ${#WT_LABELS[@]} -eq 0 ]]; then
    echo "No worktrees to show."
    return 0
  fi
  local i
  for i in "${!WT_LABELS[@]}"; do
    echo "${WT_LABELS[$i]//	/  }"
  done
}

cmd_go() {
  local root
  root="$(repo_root)"
  warn_if_not_momence "$root"
  pick_worktree "$root" "${1:-}" 1
}

cmd_open() {
  local root path
  root="$(repo_root)"
  warn_if_not_momence "$root"
  path="$(pick_worktree "$root" "${1:-}" 1)"
  if command -v cursor >/dev/null 2>&1; then
    cursor "$path"
  elif command -v code >/dev/null 2>&1; then
    code "$path"
  else
    echo "Neither cursor nor code found on PATH." >&2
    echo "$path"
    exit 1
  fi
}

cmd_rm() {
  local root force=0 query=""
  root="$(repo_root)"
  warn_if_not_momence "$root"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) query="$1"; shift ;;
    esac
  done

  local path
  path="$(pick_worktree "$root" "$query" 0)"

  if [[ "$path" == "$root" ]]; then
    echo "Refusing to remove the main checkout." >&2
    exit 1
  fi

  echo "Remove worktree: $path" >&2
  printf "Proceed? [y/N] " >&2
  local ans
  read -r ans
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    echo "Aborted." >&2
    exit 1
  fi

  if [[ "$force" -eq 1 ]]; then
    git -C "$root" worktree remove --force "$path"
  else
    git -C "$root" worktree remove "$path"
  fi
  echo "Removed $path" >&2
}

cmd_new() {
  local root
  root="$(repo_root)"
  if ! looks_like_momence "$root"; then
    echo "Refusing wt new: this does not look like the Momence monorepo (need backend/, frontend/, eslint-plugin/)." >&2
    exit 1
  fi
  create_worktree "$root" "$@"
}

cmd_prune() {
  local root
  root="$(repo_root)"
  git -C "$root" worktree prune -v
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    cmd_go
    return 0
  fi
  shift || true
  case "$cmd" in
    -h|--help|help) usage ;;
    new) cmd_new "$@" ;;
    list|ls) cmd_list "$@" ;;
    go|cd) cmd_go "$@" ;;
    rm|remove) cmd_rm "$@" ;;
    open) cmd_open "$@" ;;
    prune) cmd_prune "$@" ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
