#!/usr/bin/env bash
# wt — personal Momence feature-worktree helper
set -euo pipefail

WT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/create.sh
source "$WT_HOME/lib/create.sh"

usage() {
  cat <<'HELP'
wt — personal helper for Momence feature git worktrees

  wt                 Pick a worktree with fzf and print its path (zsh: cd)
  wt new <branch> [path] [--no-install] [--from <ref>]
  wt list
  wt go [query]      Pick a worktree (fzf) and print its path
  wt rm [query] [--force]   # auto --force if dirty (after confirm)
  wt open [query]
  wt prune

Hardcoded for the Momence monorepo layout (.worktrees/, env copy, yarn).
Only manages checkouts under <repo>/.worktrees/ — not Cursor agent trees.

list/go show a bordered table: branch, relative path, dirty, commit subject (max 100).
HELP
}

require_fzf() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive pick. Install it: brew install fzf" >&2
    exit 1
  fi
}

repo_root() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || { echo "Not inside a git repository." >&2; exit 1; }
  if [[ "$(basename "$common")" == ".git" ]]; then
    dirname "$common"
  else
    git rev-parse --path-format=absolute --show-toplevel
  fi
}

looks_like_momence() {
  local root="$1"
  [[ -d "$root/backend" && -d "$root/frontend" && -d "$root/eslint-plugin" ]]
}

warn_if_not_momence() {
  local root="$1"
  if ! looks_like_momence "$root"; then
    echo "Warning: this does not look like the Momence monorepo (expected backend/, frontend/, eslint-plugin/)." >&2
  fi
}

truncate_subject() {
  local s="$1"
  local max="${2:-100}"
  if ((${#s} > max)); then
    printf '%s' "${s:0:$((max - 1))}…"
  else
    printf '%s' "$s"
  fi
}

worktree_dirty() {
  local path="$1"
  if ! git -C "$path" diff --quiet HEAD 2>/dev/null || ! git -C "$path" diff --cached --quiet 2>/dev/null; then
    return 0
  fi
  if [[ -n "$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null | head -1)" ]]; then
    return 0
  fi
  return 1
}

rel_path() {
  local root="$1" path="$2"
  if [[ "$path" == "$root" ]]; then
    printf '%s' "."
  elif [[ "$path" == "$root"/* ]]; then
    printf '%s' "${path#"$root"/}"
  else
    printf '%s' "$path"
  fi
}

# Populate WT_PATHS, WT_NAMES, WT_RELS, WT_DIRTY, WT_SUBJ
load_feature_worktrees() {
  local root="$1"
  local include_main="${2:-0}"
  WT_PATHS=()
  WT_NAMES=()
  WT_RELS=()
  WT_DIRTY=()
  WT_SUBJ=()

  local path="" branch="" detached=0
  local prefix="$root/.worktrees/"

  flush() {
    [[ -z "$path" ]] && return 0

    local name="" dirty=" " subj=""
    subj="$(truncate_subject "$(git -C "$path" log -1 --pretty=%s 2>/dev/null || true)" 100)"
    if worktree_dirty "$path"; then
      dirty="*"
    fi

    if [[ "$include_main" -eq 1 && "$path" == "$root" ]]; then
      WT_PATHS+=("$path")
      WT_NAMES+=("main")
      WT_RELS+=("$(rel_path "$root" "$path")")
      WT_DIRTY+=("$dirty")
      WT_SUBJ+=("$subj")
      return 0
    fi

    case "$path" in
      "$prefix"*)
        name="$branch"
        [[ -z "$name" && "$detached" -eq 1 ]] && name="(detached)"
        [[ -z "$name" ]] && name="$(basename "$path")"
        WT_PATHS+=("$path")
        WT_NAMES+=("$name")
        WT_RELS+=("$(rel_path "$root" "$path")")
        WT_DIRTY+=("$dirty")
        WT_SUBJ+=("$subj")
        ;;
    esac
  }

  while IFS= read -r line; do
    if [[ -z "$line" ]]; then
      flush
      path=""; branch=""; detached=0
      continue
    fi
    case "$line" in
      worktree\ *) path="${line#worktree }" ;;
      branch\ *) branch="${line#branch refs/heads/}" ;;
      detached) detached=1 ;;
    esac
  done < <(git worktree list --porcelain)
  flush
}

# Compute column widths into W_BRANCH W_PATH W_DIRTY W_COMMIT
table_widths() {
  local i
  W_BRANCH=6  # "BRANCH"
  W_PATH=4    # "PATH"
  W_DIRTY=1   # "*"
  W_COMMIT=6  # "COMMIT"
  for i in "${!WT_NAMES[@]}"; do
    if (( ${#WT_NAMES[$i]} > W_BRANCH )); then W_BRANCH=${#WT_NAMES[$i]}; fi
    if (( ${#WT_RELS[$i]} > W_PATH )); then W_PATH=${#WT_RELS[$i]}; fi
    if (( ${#WT_SUBJ[$i]} > W_COMMIT )); then W_COMMIT=${#WT_SUBJ[$i]}; fi
  done
}

pad() {
  local s="$1" w="$2"
  printf '%-*s' "$w" "$s"
}

# One data row: │ name │ path │ * │ commit │
table_row() {
  local i="$1"
  printf '│ %s │ %s │ %s │ %s │' \
    "$(pad "${WT_NAMES[$i]}" "$W_BRANCH")" \
    "$(pad "${WT_RELS[$i]}" "$W_PATH")" \
    "$(pad "${WT_DIRTY[$i]}" "$W_DIRTY")" \
    "$(pad "${WT_SUBJ[$i]}" "$W_COMMIT")"
}

table_rule() {
  # $1 = left $2 = mid $3 = right  e.g. ┌ ┬ ┐
  local l="$1" m="$2" r="$3"
  local i
  printf '%s' "$l"
  printf '─%.0s' $(seq 1 $((W_BRANCH + 2)))
  printf '%s' "$m"
  printf '─%.0s' $(seq 1 $((W_PATH + 2)))
  printf '%s' "$m"
  printf '─%.0s' $(seq 1 $((W_DIRTY + 2)))
  printf '%s' "$m"
  printf '─%.0s' $(seq 1 $((W_COMMIT + 2)))
  printf '%s\n' "$r"
}

table_header_row() {
  printf '│ %s │ %s │ %s │ %s │' \
    "$(pad "BRANCH" "$W_BRANCH")" \
    "$(pad "PATH" "$W_PATH")" \
    "$(pad "*" "$W_DIRTY")" \
    "$(pad "COMMIT" "$W_COMMIT")"
  printf '\n'
}

# Print full bordered table to stdout
print_table() {
  table_widths
  table_rule "┌" "┬" "┐"
  table_header_row
  table_rule "├" "┼" "┤"
  local i
  for i in "${!WT_NAMES[@]}"; do
    table_row "$i"
    printf '\n'
  done
  table_rule "└" "┴" "┘"
}

# Build selectable fzf lines (data rows only) + sticky header with borders
fzf_header() {
  table_widths
  {
    table_rule "┌" "┬" "┐"
    table_header_row
    table_rule "├" "┼" "┤"
  } | tr '\n' $'\n'
}

pick_worktree() {
  local root="$1"
  local query="${2:-}"
  local include_main="${3:-0}"

  load_feature_worktrees "$root" "$include_main"

  if [[ ${#WT_PATHS[@]} -eq 0 ]]; then
    echo "No feature worktrees under $root/.worktrees/" >&2
    exit 1
  fi

  local idxs=()
  local i
  if [[ -n "$query" ]]; then
    for i in "${!WT_PATHS[@]}"; do
      if [[ "${WT_NAMES[$i]}" == *"$query"* || "${WT_RELS[$i]}" == *"$query"* || "${WT_SUBJ[$i]}" == *"$query"* || "${WT_PATHS[$i]}" == *"$query"* ]]; then
        idxs+=("$i")
      fi
    done
  else
    for i in "${!WT_PATHS[@]}"; do
      idxs+=("$i")
    done
  fi

  if [[ ${#idxs[@]} -eq 0 ]]; then
    echo "No worktree matched: $query" >&2
    exit 1
  fi

  if [[ ${#idxs[@]} -eq 1 ]]; then
    printf '%s\n' "${WT_PATHS[${idxs[0]}]}"
    return 0
  fi

  require_fzf
  table_widths

  local rows=()
  for i in "${idxs[@]}"; do
    rows+=("$(table_row "$i")")
  done

  local header
  header="$(table_rule "┌" "┬" "┐"; table_header_row; table_rule "├" "┼" "┤")"

  local choice
  choice="$(printf '%s\n' "${rows[@]}" | fzf --height=40% --reverse --prompt='worktree> ' --header="$header")" || exit 1

  for i in "${idxs[@]}"; do
    if [[ "$(table_row "$i")" == "$choice" ]]; then
      printf '%s\n' "${WT_PATHS[$i]}"
      return 0
    fi
  done
  echo "Selection did not match a known worktree." >&2
  exit 1
}

cmd_list() {
  local root
  root="$(repo_root)"
  warn_if_not_momence "$root"
  load_feature_worktrees "$root" 1
  if [[ ${#WT_PATHS[@]} -eq 0 ]]; then
    echo "No worktrees to show."
    return 0
  fi
  print_table
}

cmd_go() {
  local root
  root="$(repo_root)"
  warn_if_not_momence "$root"
  pick_worktree "$root" "${1:-}" 1
}

cmd_open() {
  local root path
  root="$(repo_root)"
  warn_if_not_momence "$root"
  path="$(pick_worktree "$root" "${1:-}" 1)"
  if command -v cursor >/dev/null 2>&1; then
    cursor "$path"
  elif command -v code >/dev/null 2>&1; then
    code "$path"
  else
    echo "Neither cursor nor code found on PATH." >&2
    echo "$path"
    exit 1
  fi
}

cmd_rm() {
  local root force=0 query=""
  root="$(repo_root)"
  warn_if_not_momence "$root"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) query="$1"; shift ;;
    esac
  done

  local path
  path="$(pick_worktree "$root" "$query" 0)"

  if [[ "$path" == "$root" ]]; then
    echo "Refusing to remove the main checkout." >&2
    exit 1
  fi

  local dirty=0
  if worktree_dirty "$path"; then
    dirty=1
    force=1
  fi

  echo "Remove worktree: $path" >&2
  if [[ "$dirty" -eq 1 ]]; then
    echo "Note: it has modified/untracked files (often node_modules). Will use --force." >&2
  fi
  echo "Deleting can take a while if node_modules is large (~1GB+)." >&2
  printf "Proceed? [y/N] " >&2
  local ans
  read -r ans
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    echo "Aborted." >&2
    exit 1
  fi

  echo "Removing…" >&2
  if [[ "$force" -eq 1 ]]; then
    git -C "$root" worktree remove --force "$path"
  else
    git -C "$root" worktree remove "$path"
  fi
  echo "Removed $path" >&2
}

cmd_new() {
  local root
  root="$(repo_root)"
  if ! looks_like_momence "$root"; then
    echo "Refusing wt new: this does not look like the Momence monorepo (need backend/, frontend/, eslint-plugin/)." >&2
    exit 1
  fi
  create_worktree "$root" "$@"
}

cmd_prune() {
  local root
  root="$(repo_root)"
  git -C "$root" worktree prune -v
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    cmd_go
    return 0
  fi
  shift || true
  case "$cmd" in
    -h|--help|help) usage ;;
    new) cmd_new "$@" ;;
    list|ls) cmd_list "$@" ;;
    go|cd) cmd_go "$@" ;;
    rm|remove) cmd_rm "$@" ;;
    open) cmd_open "$@" ;;
    prune) cmd_prune "$@" ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
